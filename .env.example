# DAVID SLING IATOS - environment template (zero hardcoded secrets).
# Copy to .env and fill in. Never commit real secrets.

# --- Runtime mode ---
DAVID_SLING_MODE=sim            # sim | live | backtest
DAVID_SLING_HOST=0.0.0.0
DAVID_SLING_PORT=8000

# --- API security (Phase 1 web layer) ---
DAVID_SLING_API_TOKEN=change-me-dev-token

# --- Account / risk (simulated broker defaults) ---
DAVID_SLING_ACCOUNT_BALANCE=100000.0
DAVID_SLING_ACCOUNT_CURRENCY=USD
DAVID_SLING_RISK_PER_TRADE_PCT=1.00
DAVID_SLING_SESSION_RISK_CAP_PCT=1.50
DAVID_SLING_DAILY_LOSS_LIMIT_PCT=3.00

# --- Broker bridge (used when DAVID_SLING_MODE=live) ---
DAVID_SLING_BROKER=simulated    # simulated | mt5 | mt4 | ctrader | fix | rest
DAVID_SLING_MT5_SERVER=
DAVID_SLING_MT5_LOGIN=
DAVID_SLING_MT5_PASSWORD=
DAVID_SLING_FIX_CONFIG_PATH=

# --- Alert channels ---
DAVID_SLING_TELEGRAM_BOT_TOKEN=
DAVID_SLING_TELEGRAM_CHAT_ID=
DAVID_SLING_WEBHOOK_URL=

# --- Storage ---
DAVID_SLING_STORAGE_DIR=storage
DAVID_SLING_LEDGER_PATH=storage/audit/evidence_ledger.jsonl
