# DAVID SLING IATOS - Phase 1 web API (FastAPI ASGI) image
FROM python:3.12-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    DAVID_SLING_LEDGER_PATH=/app/storage/audit/evidence_ledger.jsonl

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY pyproject.toml ./
COPY src ./src
COPY config ./config
COPY main.py run.py ./
RUN pip install --no-cache-dir -e .

EXPOSE 8000
CMD ["python", "main.py", "--mode", "sim", "--host", "0.0.0.0", "--port", "8000"]
